{
  "description": "Audit snapshot only; Railway does not automatically read this file. Configure these values on the service through the connector/dashboard.",
  "projectId": "a1ad9b63-e582-46b6-9c4a-4566a682c1f1",
  "environmentId": "dcc6e47d-ac81-43a1-88d1-44695fea3bfa",
  "serviceId": "5a28a95f-7579-4595-8755-a9a1aeddb151",
  "source": {
    "repo": "KevinYoungsir/flow2api",
    "branch": "deploy/railway-single-service",
    "commitHash": "5d6c401df4330b411c4f8c6aec92677455f81af3"
  },
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "startCommand": "python main.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "sleepApplication": false,
    "region": "sfo",
    "replicas": 1,
    "limits": { "vCPUs": 0.5, "memoryGB": 0.5 }
  },
  "volume": {
    "name": "flow2api-data",
    "id": "a5f5a5fe-1b12-46af-b8e4-79be8b3cabf2",
    "mountPath": "/app/data",
    "sizeMB": 500
  },
  "domains": {
    "railway": "flow2api-production-d82c.up.railway.app",
    "custom": "socool.xin",
    "targetPort": 8000
  },
  "publicUrls": {
    "FLOW2API_PUBLIC_BASE_URL": "https://socool.xin",
    "FLOW2API_CORS_ORIGINS": "https://flow2api-production-d82c.up.railway.app,https://socool.xin"
  }
}
